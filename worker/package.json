{
  "name": "notme-bot-site",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "format": "prettier --write \"public/**/*.{html,css,js}\" \"*.{ts,js,css,html,md,yml,yaml,json}\" \"src/**/*.ts\"",
    "lint:format": "prettier --check \"public/**/*.{html,css,js}\" \"*.{ts,js,css,html,md,yml,yaml,json}\" \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:local": "esbuild worker.ts --bundle --format=esm --outfile=dist/worker.js --conditions=workerd --external:cloudflare:workers --external:@cloudflare/vitest-plugin",
    "test:do": "vitest run --config vitest.workers.config.mts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.6",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "@notme/contract": "workspace:*",
    "@agentic-research/dpop": "workspace:*",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@peculiar/asn1-schema": "3.0.0",
    "@peculiar/x509": "3.1.0",
    "@simplewebauthn/server": "^13.3.2",
    "asn1js": "4.0.0",
    "cbor-x": "^1.6.4",
    "reflect-metadata": "0.2.2",
    "zod": "^4.6.6"
  }
}
