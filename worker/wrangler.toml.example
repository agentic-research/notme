#:schema node_modules/wrangler/config-schema.json
# Copy to wrangler.toml and fill in your CF resource IDs.
name = "notme-bot"
main = "worker.ts"
compatibility_date = "2026-03-01"

workers_dev = false

[observability]
enabled = true

[observability.logs]
enabled = true
invocation_logs = true

# Rate limiting — atomic, edge-fast, replaces KV-based limiter
# Token endpoint: 20 per principal per minute
[[ratelimits]]
name = "TOKEN_LIMITER"
namespace_id = "1001"
  [ratelimits.simple]
  limit = 20
  period = 60

# Cert exchange: 10 per repo per minute
[[ratelimits]]
name = "CERT_LIMITER"
namespace_id = "1002"
  [ratelimits.simple]
  limit = 10
  period = 60

# Passkey registration: 5 attempts per IP per minute
[[ratelimits]]
name = "PASSKEY_LIMITER"
namespace_id = "1003"
  [ratelimits.simple]
  limit = 5
  period = 60

# Custom domain routes — adjust zone_name to your domain.
[[routes]]
pattern = "notme.bot/*"
zone_name = "notme.bot"

[[routes]]
pattern = "auth.notme.bot/*"
zone_name = "notme.bot"

[assets]
directory = "public"
binding = "ASSETS"
not_found_handling = "404-page"
# Worker handles routing first — prevents Assets from auto-serving index.html
# on auth.notme.bot (subdomain needs different content than main domain /).
run_worker_first = true

[vars]
SITE_URL = "https://notme.bot"
SIGNET_AUTHORITY_URL = "https://auth.notme.bot"
# Comma-separated list of GitHub org/user names allowed to exchange GHA OIDC tokens
# for bridge certs at auth.notme.bot/cert/gha.
GHA_ALLOWED_OWNERS = "your-org"

# Workers VPC — direct tunnel to signet on Fly (identity server).
# Create via: wrangler vpc create <name>
# CF TF provider does not support vpc_service binding type — configured here directly.
[[vpc_services]]
binding = "VPC_AUTH"
service_id = "<your-vpc-service-id>"

# CA bundle cache — stores current CA bundle for edge revocation checks.
# Create via: wrangler kv namespace create CA_BUNDLE_CACHE
[[kv_namespaces]]
binding = "CA_BUNDLE_CACHE"
id = "<your-kv-namespace-id>"

# Signing authority — DO-stored Ed25519 CA key (zero-copy, born in CF).
[[durable_objects.bindings]]
name = "SIGNING_AUTHORITY"
class_name = "SigningAuthority"

# Revocation authority — Durable Object for atomic seqno tracking (rollback protection).
[[durable_objects.bindings]]
name = "REVOCATION"
class_name = "RevocationAuthority"

[[migrations]]
tag = "v1"
new_classes = ["RevocationAuthority"]

[[migrations]]
tag = "v2"
new_sqlite_classes = ["SigningAuthority"]

# ── Staging environment (ADR-018 promotion gate) ─────────────────────────────
#
# A fully separate Worker with its OWN Durable Objects — its own
# SigningAuthority CA key (born in staging), own RevocationAuthority, own KV —
# so `task ship-staging` exercises the real Worker/DO boundary without
# touching production state. Deliberate differences from production, each
# load-bearing:
#   - No VPC_AUTH binding: worker.ts guards `if (env.VPC_AUTH)`, so staging
#     falls through to a 503 instead of proxying to the production backend.
#   - SIGNET_AUTHORITY_URL names the staging authority host;
#     authorityHostFromEnv() in worker.ts selects the authority surface from
#     this var, so no code drift between environments.
#   - Hosts must stay under your zone: worker.ts 301s any other host (e.g.
#     workers.dev) to the canonical domain before serving anything.
#
# Environments do not inherit routes/vars/bindings — everything below is
# intentionally redeclared. Create the staging KV via:
#   wrangler kv namespace create CA_BUNDLE_CACHE_STAGING
[env.staging]
name = "notme-bot-staging"
workers_dev = false

[env.staging.observability]
enabled = true

[env.staging.observability.logs]
enabled = true
invocation_logs = true

[[env.staging.routes]]
pattern = "staging.notme.bot"
custom_domain = true

[[env.staging.routes]]
pattern = "auth-staging.notme.bot"
custom_domain = true

[env.staging.assets]
directory = "public"
binding = "ASSETS"
not_found_handling = "404-page"
run_worker_first = true

[env.staging.vars]
SITE_URL = "https://staging.notme.bot"
SIGNET_AUTHORITY_URL = "https://auth-staging.notme.bot"
# MUST differ from production. worker.ts refuses every GHA exchange when this
# is unset (no default), so a staging authority that says nothing trusts
# nobody rather than silently inheriting production's org (notme-1532eb).
GHA_ALLOWED_OWNERS = "your-staging-org"
# MUST be set. Unset falls back to the PRODUCTION audience set in
# allowed-audiences.ts, which would let staging mint tokens for production's
# resource servers.
ALLOWED_AUDIENCES = "https://staging.notme.bot,https://auth-staging.notme.bot"

[[env.staging.kv_namespaces]]
binding = "CA_BUNDLE_CACHE"
id = "<your-staging-kv-namespace-id>"

[[env.staging.durable_objects.bindings]]
name = "SIGNING_AUTHORITY"
class_name = "SigningAuthority"

[[env.staging.durable_objects.bindings]]
name = "REVOCATION"
class_name = "RevocationAuthority"

# Same limits as production — staging exists to exercise the production
# code path, and an unlimited staging would not.
[[env.staging.ratelimits]]
name = "TOKEN_LIMITER"
namespace_id = "1001"
  [env.staging.ratelimits.simple]
  limit = 20
  period = 60

[[env.staging.ratelimits]]
name = "CERT_LIMITER"
namespace_id = "1002"
  [env.staging.ratelimits.simple]
  limit = 10
  period = 60

[[env.staging.ratelimits]]
name = "PASSKEY_LIMITER"
namespace_id = "1003"
  [env.staging.ratelimits.simple]
  limit = 5
  period = 60
